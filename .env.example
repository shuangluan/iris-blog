# ============ Giscus (comments via GitHub Discussions) ============
# Get these from https://giscus.app after enabling Discussions on your repo.
NEXT_PUBLIC_GISCUS_REPO=yourname/yourrepo
NEXT_PUBLIC_GISCUS_REPO_ID=R_xxx
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
NEXT_PUBLIC_GISCUS_CATEGORY_ID=DIC_xxx

# ============ Plausible (optional, privacy-first analytics) ============
# Leave blank to disable. Vercel Analytics is already wired via <Analytics />.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ============ Site metadata ============
NEXT_PUBLIC_SITE_URL=https://irisluan.com

# ============ Buy Me a Coffee (optional tip jar) ============
# Your buymeacoffee.com username (whatever comes after buymeacoffee.com/).
# Leave blank to hide the tip jar entirely.
NEXT_PUBLIC_BUYMEACOFFEE_USERNAME=
